# Fleet 物理绑定 —— 公开契约（只有变量名与角色说明，永无真值）
#
# 判据：docs/conventions/information-boundary.md
#   第一层「公开」    = 代号、角色、协议常量、RFC1918 → 就在本文件与仓内散文里
#   第二层「仓外解析」= 本文件声明的每个变量的**值** → 三处真值载体见下
#   第三层「私有散文」= 主机清单等，见 docs/private/runbook/host-inventory.md
#
# 真值落三处，一机一档（复用 ops/lib/feishu-send.sh 已确立的 per-machine env 范式：
# 本地 ~/.nvy/<name>.env / 主机 /etc/nvy-<name>.env）：
#   dev 机          → ~/.nvy/fleet.env          脚本顶部 `. ~/.nvy/fleet.env`
#   各主机          → /etc/nvy-fleet.env        unit 用 `EnvironmentFile=-/etc/nvy-fleet.env`
#   GitHub Actions  → repo secrets              workflow 用 ${{ secrets.* }}
#
# 🔁 换物理机 = 改上面三处对应的一行，**仓内零改动**。这是本机制存在的全部理由。
#
# 命名法：NVY_<代号大写>_<字段>。代号是**角色**，不是机器 —— 机器换了代号不变。
#
# ⚠️ 两类键刻意**不是**标识符，只为脚本引用方便，L2 值层不据其派生（机器侧对应
#    check-identifier-boundary.ts 的 NON_IDENTIFIER_KEY）：
#      _SSH_ALIAS  —— alias 本身就是一种代号；有识别性的是 alias→IP 的映射
#      _REPO_DIR   —— 文件系统路径；systemd WorkingDirectory= 必须字面量，env 化不了
#    判据见 docs/conventions/information-boundary.md § 两条容易判错的边界。

# ── app：业务 server 宿主（nginx + app + PG + redis，对外 API 域名指向它） ──────
# ⚠️ 此机的 ssh alias 历史上带 staging 字样，但它是**生产**。alias 与代号并存且都公开
#    （alias 给 shell 用、代号给散文用），所以这个误名**不是安全问题、是可读性问题**：
#    仓内散文一律只说代号 app，别用 alias 指代它，否则读者会以为那是预发环境。
#    per information-boundary.md § 代号纪律。
NVY_APP_SSH=                  # <user>@<host>，供 `ssh "$NVY_APP_SSH"` 直接用
NVY_APP_HOST=                 # 仅主机部分（CI 里对应 secrets.APP_HOST）
NVY_APP_SSH_ALIAS=            # 本机 ~/.ssh/config 里的 alias
NVY_APP_REPO_DIR=             # 主机上的 clone 路径（deploy 在此 git reset --hard）

# ── index：接地检索 / code-index 宿主（无部署 workflow，靠主机侧 git fetch 自更新） ──
NVY_INDEX_SSH=
NVY_INDEX_SSH_ALIAS=
NVY_INDEX_REPO_DIR=

# ── broker-hk：券商网关（OpenD + futu-shim；经 app 中转 + WireGuard，无 GitHub 凭据） ──
NVY_BROKER_HK_SSH=
NVY_BROKER_HK_SSH_ALIAS=
NVY_BROKER_HK_WG_ENDPOINT=    # <公网IP>:<port>，WireGuard Endpoint 整串

# ── 访客通道 WireGuard 对端 ────────────────────────────────────────────────
NVY_GUEST_WG_ENDPOINT=        # <公网IP>:<port>

# ── quant-win：实盘交易终端（无 SSH，仅云助手 RunCommand + RDP） ──────────────
NVY_QUANT_WIN_ECS_ID=         # 云主机实例 ID，供 `aliyun ecs RunCommand` 用

# ── quant-linux：量化计算 ──────────────────────────────────────────────────
NVY_QUANT_LINUX_SSH=

# ── 容器镜像仓 ─────────────────────────────────────────────────────────────
# <registry-host>/<namespace>/<repo>，不含 tag。实例 ID 编在 registry host 里，
# 所以整串属第二层。CI 侧对应 secrets.ACR_REGISTRY；主机侧 rollback 脚本读本变量。
NVY_ACR_REPO=
