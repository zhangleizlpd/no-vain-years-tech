[Unit]
Description=Static trading-calendar annual-update reminder timer (1st & 15th of each month)
Documentation=file:///home/admin/no-vain-years-mono/ops/runbook/scheduled-tasks.md

[Timer]
# 每月 1 号 + 15 号 09:15（避开 77 上 08:30 cert / 09:00 sync-report）。大半年 exit 0 静默；
# Q4（10/11/12 月）未覆盖次年时每月 2 次催更 → 两周一次、够密不至于漏、又不至刷屏。
# 覆盖感知：一旦年更 PR 部署到 77（覆盖年份跳到次年）→ 下次跑即 exit 0 静默、自动停催。
OnCalendar=*-*-01,15 09:15:00
# Persistent：本任务调度稀疏，补跑宕机期间漏掉的一次（别错过唯一的催更窗口）。
Persistent=true

[Install]
WantedBy=timers.target
