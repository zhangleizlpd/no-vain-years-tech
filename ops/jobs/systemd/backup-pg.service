# backup-pg（77）：每日 pg_dump | gzip → 本地磁盘，保留最新 3 份。判据全在 backup-pg.sh；
# .sh 零飞书 I/O，告警靠本 unit 套的 wrapper（退出码驱动）。
#
# 🚨 **本任务 2026-08-08 之前不长这样** —— 它走 `/etc/cron.d/mbw-backup-pg`，是 fleet 里唯一
#    「有调度但失败不产生任何信号」的任务：不套 wrapper（退出码没人看）· 无心跳 · 不在看门狗
#    名单 · 也**登记不进** `scheduled-tasks.md`（`check-scheduled-tasks` 只扫 `*.timer`，
#    cron.d 不产生 .timer ⇒ 机器强制对它结构性失明）。后果实测：OSS 上传自 07-13 起失败、
#    07-29 起连续全败，潜伏三周无人知晓（#887 / #892）。迁进 ops/jobs 范式后四条防线一次补齐。
#
# 🚨 **--on-success 故意用默认的 report（不加 silent）**：每日 1 跑，一条 ✅ 是这台机器上
#    **唯一**的数据保护机制的正向 liveness。对照 4h 高频的探针族（6 次/日）才用 silent 压噪音，
#    本任务不适用。改成 silent 就只剩「失败才响」+ 看门狗兜 no-show，会丢掉「跑了且产物合格」
#    这个信息 —— 而它恰恰是你唯一想每天确认一次的事。
#
# 🚨 **以 root 跑是刻意的 —— 别加 `User=admin`**（2026-08-08 评估后明确否掉）。旧 cron 是以
#    `admin` 跑的，照着「对齐旧行为」改回去会同时踩两个坑：
#    ① **心跳写不进去**：`/var/lib/nvy/heartbeats` 是 `root:root 0755`，admin 无写权限；而
#       wrapper 写心跳那行是 `|| true`，**失败完全静默** ⇒ 看门狗从此每天误报 no-show
#       —— 正是本任务刚根治的「有调度、无信号」换个形式复活。
#    ② **安全性倒退**：产物是**全库 dump**（含全部用户数据）。root 跑 ⇒ `root:0600`；改成
#       admin 跑会回到旧 cron 时代的 `-rw-rw-r--`，即**世界可读**地摊在盘上。
#    代价只有一个：**恢复时需 sudo 才读得到备份**。恢复是低频且刻意的操作，这个代价该付。
#
# Install: 仓根跑 `sudo bash ops/jobs/install.sh`（幂等，一次装齐全部任务；enable 由人定）
# 手动触发验证：systemctl start backup-pg.service  （→ 应收一条飞书 report）
# 飞书 webhook/secret + 心跳目录来自 /etc/nvy-alert.env（NVY_ALERT_* / NVY_HEARTBEAT_DIR；缺 webhook → 静默跳过）。
[Unit]
Description=Daily PostgreSQL backup to local disk (pg_dump | gzip, keep latest 3)
Documentation=file:///home/admin/no-vain-years-mono/ops/runbook/scheduled-tasks.md
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
# 公共飞书配置（NVY_ALERT_*）+ 心跳目录（NVY_HEARTBEAT_DIR）—— 全机共享，wrapper 用。
EnvironmentFile=-/etc/nvy-alert.env
# 本任务调参（RETENTION_COPIES / MIN_SIZE_PCT / BACKUP_DIR / COMPOSE_FILE / ENV_FILE）——
# 可选，'-' = 缺则不报错。脚本内默认值已经是 77 的真值，正常无需这个文件。
EnvironmentFile=-/etc/backup-pg.env
# 套通用 wrapper：跑完（成功/失败）都推飞书 report + 写心跳供看门狗查 no-show。
# --tail 取默认 20：脚本 happy path 只有 4 行，失败路径最多再加 pg_dump / docker 的 stderr，20 行罩得住。
ExecStart=/usr/bin/bash /usr/local/lib/nvy/nvy-run-reported.sh backup-pg -- /usr/local/lib/nvy/jobs/backup-pg.sh
