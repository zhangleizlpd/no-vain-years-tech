# anchor-intraday-trace-archive（77）：每小时把 app 容器 stdout 里**会被 13 小时环覆盖掉**的
# 留痕落到 /var/lib/nvy/anchor-intraday-trace/。承载 061 SC-006「失败轮次可从留痕中逐条查出」，
# 见 issue #98。过滤口径（剔 agent-queue 噪音而非只留关键字）与实测数据全在
# ops/jobs/anchor-intraday-trace-archive.sh 头部，改口径改那里。
# Install: 仓根跑 `sudo bash ops/jobs/install.sh`（幂等，一次装齐全部任务；enable 由人定）
# 手动触发验证：systemctl start anchor-intraday-trace-archive.service
#   → 成功时**静默不推**（见下 --on-success silent）；验证看 journalctl 的 ✅ 摘要行，
#     或直接 ls /var/lib/nvy/anchor-intraday-trace/
# 飞书 webhook/secret + 心跳目录来自 /etc/nvy-alert.env（NVY_ALERT_* / NVY_HEARTBEAT_DIR）。
[Unit]
Description=Archive app-container trace outliving the log ring (061 SC-006 / issue #98)
Documentation=file:///home/admin/no-vain-years-mono/ops/runbook/scheduled-tasks.md
# 要 `docker logs` ⇒ 排在 docker 之后。**只排序不依赖**（After= 而非 Requires=）：
# docker 没起本来就该由本任务报出来，用 Requires= 会让它跟着一起不跑 = 该报时沉默。
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
# 公共飞书配置（NVY_ALERT_*）+ 心跳目录（NVY_HEARTBEAT_DIR）—— 全机共享，wrapper 用。
EnvironmentFile=-/etc/nvy-alert.env
# 本任务调参（ANCHOR_TRACE_CONTAINER / _DIR / _RETAIN_DAYS / _NOISE_RE）—— 可选，一般不需要。
EnvironmentFile=-/etc/anchor-intraday-trace-archive.env
# 套通用 wrapper：退出码驱动飞书（零新飞书基建）+ 每跑写心跳供看门狗查 no-show。
# 🚨 --on-success silent（**偏离每日批任务的默认 report**，故意为之）：一小时一跑 = 24 次/日，
#    成功也推会把飞书刷成噪音 → 训练出「反正都是 ✅，不看了」= 真告警来时被淹没。
#    代价 = 没有正向 liveness → 由看门狗兜（nvy-watchdog 查本任务心跳，
#    anchor-intraday-trace-archive:10800 ⇒ 连漏 3 次才报，而丢数据要连漏 13 次）。
# --tail 5：脚本只输出单行摘要，5 行足够罩住它 + 故障时的 stderr 诊断。
ExecStart=/usr/bin/bash /usr/local/lib/nvy/nvy-run-reported.sh anchor-intraday-trace-archive --on-success silent --tail 5 -- /usr/local/lib/nvy/jobs/anchor-intraday-trace-archive.sh
