node_modules/

# Build output
dist/
build/
out-tsc/

# runtime-smoke e2e export — dedicated dir so the OSS-env `expo export` never
# shares `dist/` with `mobile:build` (no-env) when nx runs both concurrently
# (issue #625; see apps/mobile/playwright.runtime-smoke.config.ts webServer note).
apps/mobile/dist-runtime-smoke/

# Test
coverage/

