# 访客侧入口。两类上游、两套市场口径，别把其中一套当成全局规则：
#   · 打港机 futu-shim 的行情面（K 线 + 期权链三条 + 标的级 /overview）—— **只放美股**
#   · 打本机 mono 的业务面（研报投递 / 锚两条 / 标的注册表两条）—— **A股 + 港股 + 美股**
#     （锚两条按 059 只收 us/hk；判据各写各的，见各自 location）
#
# 跑在 77 (`mbw-staging`) 上、**独立于 prod compose 的 nginx**，绑 wg2 虚 IP `10.90.0.1`。
# 为什么不复用 prod nginx：那个容器 `ports: 80:80 / 443:443`，若给它加一条
# `10.90.0.1:...` 的映射，wg2 没起来时 docker 绑不上该地址 → 容器起不来 →
# `api.shintongtech.com` 跟着挂。为一个访客功能给主站加这种耦合不值。
#
# 本文件是 **template**：官方 nginx 镜像会对 /etc/nginx/templates/*.template 做
# envsubst 再落到 /etc/nginx/conf.d/。真 token 因此不入库、只从 host 环境注入。
#
# 需要的环境变量（由 docker-compose.guest.yml 的 env_file 提供）：
#   FUTU_SHIM_URL    上游 shim，正常是 http://10.89.0.1:8811
#   FUTU_SHIM_TOKEN  shim 的真 token（访客永远看不到它）
#   GUEST1_TOKEN     发给访客 1 的 bearer（与 shim token 无关，可单独吊销）
#   GUEST1_NAME      日志里的可读名字
#   GUEST_UPLOAD_TOKEN  转发给本机 mono app 的 bearer（研报投递 + 锚估值提交 + 锚直写 +
#                       标的枚举 + 标的批量基础信息 —— **五条 location 同一把**，
#                       见 /anchor-import 的闸 E。后两条是只读，前三条是写；
#                       为什么不给读面另发一把，判据单点在 mono 的
#                       apps/server/src/config/guest-upload.config.ts 顶部）
#   ANCHOR_OWNER_NAME   有权直写锚的访客名（= 某个 GUESTn_NAME 的值，059）

# ── 访客身份：Authorization 整串 → 名字。命不中 = 空 = 401 ───────────────────
# 用 map 而不是 if 链，是为了加第二个访客时只加一行，且日志里能记名字。
#
# 🚨 **`map_hash_bucket_size` 必须显式调大**：这里的 key 是整串 `Bearer <token>`，
#    而 render-env.sh 生成的是 `openssl rand -hex 24` = 48 字符 ⇒ key 长 55 字符，
#    超过 nginx 默认桶宽（64，且要求 key 短于它），nginx 直接
#    `[emerg] could not build map_hash` **起不来**。
#    ⚠️ 2026-08-04 首次上线实撞：本机预演时用的假 token 是 `guest-secret`（12 字符），
#    形状与生产不一致 ⇒ 测试全绿而真环境当场崩。**测试数据的长度也是形状的一部分。**
map_hash_bucket_size 128;

# 🚨 **每个 GUESTn_TOKEN 必须非空**。若某个访客的 token 渲染成了空串，这里的 key 就退化
#    成字面量 `Bearer `，等于凭空多出一个「几乎无口令」的身份。判据不放在这里（nginx 无从
#    校验），而是 `render-env.sh` 出包前断言每个 GUESTn_TOKEN 长度 ≥ 32 —— 那条能真失败。
map $http_authorization $guest_name {
    default                      "";
    "Bearer ${GUEST1_TOKEN}"     "${GUEST1_NAME}";
    "Bearer ${GUEST2_TOKEN}"     "${GUEST2_NAME}";
}

# ── 锚直写授权（059）—— 认证之外的**授权**：上面那个 map 回答「你是谁」，本 map 回答
#    「你能不能直接改业务数据」。两件事分开，加访客时不必动这里。
#
# 🚨 **判据必须 env 化，不得硬编码访客名**：本仓面向公开，把「谁是本人」写死在配置里就是
#    把身份冻进仓；而且它会脱离 render-env.sh 那条管道，改名字要改两处。
#
# 🚨 用 map 而不是 `if` 链，理由同上面那句原话：加第二个有权者时只加一行，且日志里能记名字。
#
# ⚠️ `ANCHOR_OWNER_NAME` 渲染成空串时，key 退化成 `""`，而 `$guest_name` 为空的请求在
#    server 级闸 1 就已 401 ⇒ 效果是「谁都不许直写」。方向 fail-closed、可接受，但要能一眼
#    看出来 —— render-env.sh 为此断言它非空（那条能真失败）。
map $guest_name $anchor_write_allowed {
    default                "0";
    "${ANCHOR_OWNER_NAME}" "1";
}

# ── 限频：按访客计，不按 IP ─────────────────────────────────────────────────
# 每个 zone 的额度都是**从上游那个 capability 的官方限额里切出来的一份**，而这些池
# **全部与 prod 的 EOD 采集共用**。切多少的判据只有一个：打满时 prod 那轮还跑不跑得完。
#
# ① `history_kline` 官方 60 次/30s = 120 次/分。给访客 **110 次/分**，prod 留 10 次/分。
#
#    🔎 **它比另两个池宽得多，是有真账的**：08-01 的 `ok=2/fail=5` 回填事故一度被当成
#    「这个池很紧」的证据，但那次的**根因是计量 bug，不是池子紧** ——
#      ① `/kline` 当时对**每一页**都计闸，而官方明说「分页只有首页计入限频」；
#      ② `history_kline` 被错挂在 10/30s 的最严兜底上（官方真值 60/30s，6 倍偏严）。
#    两条都已在 #762 修掉。修完后 prod 的实际用量小得多：日常 EOD 12 只锚 = **12 次调用**，
#    连 10 年回填 7 只票也只有 **7 次**（分页豁免）⇒ 留 10 次/分绰绰有余。
#
#    ⚠️ 本值自 2026-08-05 起已在 77 上生效（当时是**手改 + reload**，08-07 才补齐注释与
#    文档口径）。别在 77 上直接改这个文件 —— 经过与后果见 runbook 同名小节。
limit_req_zone $guest_name zone=guest_kline:1m rate=110r/m;

# ② 🔴 `option_chain` 官方只有 **10 次/30s = 20 次/分** —— 上游最紧的一个池，比
#    `history_kline` 紧 6 倍（这是官方真值不是保守兜底，2026-08-04 直取
#    openapi.futunn.com 复核）。照抄 ① 的 20r/m 等于**把整个池给访客一个人**。
#
#    **给 10 次/分 = 对半分**（2026-08-04 owner 定；此前是 5 次/分 = 25%）。
#    🚨 **这个数踩在门上，不是留有余量的**：prod 的链发现是 12 只锚 × 约 10-14 个
#    到期日窗 = 120-170 次调用；剩 10 次/分 ⇒ **12-17 分钟**，而 SC-009 的门是
#    **15 分钟** —— 上界会顶出去。撑住它的是两件事，都不是配置保证的：
#      ① **时段错开** —— 访客不会恰好在 06:00 CST 那一轮里满速打；
#      ② **顶出去也不丢数** —— 上游 429 让 server 侧走 `budgetExhausted` 延迟重入队、
#         不耗 attempts，所以后果是**慢**不是**失败**。
#    ⇒ **上线后第一个交易日必须核对那轮 `SyncRun` 的墙钟**；持续贴着 15 分钟就把这个
#      数调回去。别把「至今没红」当成余量。
limit_req_zone $guest_name zone=guest_option_chain:1m rate=10r/m;

# ③ `expiration_date` 与 `snapshot` 官方均 60 次/30s = 120 次/分，与 ① 同档，故同额度。
limit_req_zone $guest_name zone=guest_option_meta:1m rate=20r/m;

# ④ 研报投递（057）。🚨 **它与上面三个不是同一类账**，别照抄它们的推理：
#    ①②③ 护的是**上游 vendor 的官方限额**（额度是从富途那边切来的，给访客多少 prod 就少多少）；
#    本 zone 护的是**本机磁盘** —— `proxy_request_buffering` 默认 on，请求 body 会**整份先落盘**
#    再转发，而本机可用磁盘是几个 G 量级（同顶部 codes 截断那段的理由）。
#
#    算账：2r/m × 16MB × burst 1 ⇒ 峰值驻留约 48MB，安全。
#    研报是人工产出物、一天几份，2r/m 对真实用法**毫无束缚**；真正兜住滥用的是每投递方
#    8GB 的配额闸（在 server 侧），本 zone 只负责挡住「循环打」这一种形态。
limit_req_zone $guest_name zone=guest_upload:1m rate=2r/m;

# ⑤⑥ 锚导入（059）。**两个口各自独立的 zone**（FR-017：一方触顶不影响另一方）——
#    直写是本人的日常流水线（一天十几只锚，一只一发），提交是他人的偶发动作，
#    把它们塞进同一个池等于让谁先打满谁就把对方一起卡住。
#
#    这两条护的**既不是** vendor 限额（不打上游）**也不是**磁盘（body 只有几百字节，
#    见各自 location 的 `client_max_body_size 4k`），护的是**锚表的写入速率** ——
#    每次导入都可能冲掉人工位并写一行痕迹，循环打会把痕迹表刷成噪声、把人工判断反复抹掉。
#    ⇒ 额度按「真实用法绰绰有余、循环打立刻 429」取：
#      · 直写 6r/m：一天十几只锚、单只一发，峰值也就几发连打；burst 2 容一次小批。
#      · 提交 2r/m：与研报同档（他人的偶发动作，没有任何流水线在这条路上）。
limit_req_zone $guest_name zone=guest_anchor:1m rate=6r/m;
limit_req_zone $guest_name zone=guest_anchor_submit:1m rate=2r/m;

# ⑦⑧ 标的注册表查询。🚨 **它们护的是第三种账**，别照抄上面任何一条的推理：
#    ①②③ 护上游 vendor 的官方限额、④ 护本机磁盘、⑤⑥ 护锚表的写入速率；
#    本组护的是**本机 PG 的一次市场级全扫 + 出口体量** —— 枚举口一发要扫某市场全部行
#    （2026-08-22 实测美股 19546 行）并序列化出 158 KB（gzip 后 49 KB）；批量口一发是
#    ≤500 个唯一索引点查，便宜得多。两条都**不打上游、不落盘**，与访客的期权 / 日线
#    额度互不相干 —— 打满它们不会让 prod 少一次富途调用。
#
#    算账：
#      · 枚举 6r/m —— 真实用法是「一天拉一次全市场存下来」（能力目录明写按天缓存），
#        6 次/分对它绰绰有余，循环打立刻 429。与直写锚同额度不是巧合：同为「低频、
#        但单发昂贵」。burst 2 容一次「三个市场连着拉」。
#      · 批量 30r/m —— 美股全量 19546 / 500 = **40 发**，这是本组要支持的最重工作流，
#        30r/m 让它约 80 秒批完。burst 5 让分批脚本前几发连着过。
limit_req_zone $guest_name zone=guest_instr_codes:1m  rate=6r/m;
limit_req_zone $guest_name zone=guest_instr_basics:1m rate=30r/m;

limit_req_status 429;

# ── 日志里的 codes 截断 ─────────────────────────────────────────────────────
# `/option-snapshot` 一次可带 400 个 code ≈ 8.4 KB。原样进日志 = 单行 8 KB，
# 20 次/分打满约 230 MB/天，而 77 的可用磁盘是几个 G 量级 —— 审计价值撑不起这个代价。
# 截到 120 字符：够看出「他在查哪只票的链」，不够把盘撑爆。
#
# ⚠️ 用 `${head}` 花括号形式而非 `$head` —— 变量名后若紧跟非分隔字符，nginx 会连着
#    一起当变量名解析。这里跟的是 ASCII 括号，加括号是为了让它对后续改动也安全。
map $arg_codes $codes_logged {
    ""                   "-";
    "~^(?<head>.{120})." "${head}(truncated)";
    default              $arg_codes;
}

log_format guest_access '$time_iso8601 guest=$guest_name status=$status '
                        'uri=$uri code=$arg_code codes=$codes_logged '
                        'start=$arg_start end=$arg_end '
                        'ua="$http_user_agent" rt=$request_time';

# ── 容器存活探针（只监听 loopback，访客够不到）──────────────────────────────
# 刻意不打 /healthz：那会穿到上游 shim，把「本容器是否活着」变成对外部服务的依赖，
# shim 一抖容器就被判死重启。至于「有没有绑上 wg2 地址」不需要探针证明 ——
# 10.90.0.1 不存在时 nginx 直接 `cannot assign requested address` 起不来，
# 容器进重启循环，比任何探针都响。
server {
    listen 127.0.0.1:8812;
    location = /__ping { return 200 '{"ok":true}'; }
    location / { return 404; }
}

server {
    listen 10.90.0.1:8811;
    server_name _;
    default_type application/json;

    access_log /var/log/nginx/guest-access.log guest_access;
    error_log  /var/log/nginx/guest-error.log warn;

    # 访客不该看到上游的存在,更不该看到它的版本/路由集。
    server_tokens off;

    # 🚨 **`/option-snapshot` 一次可带 400 个 code ⇒ query string ≈ 8.4 KB，超过默认
    #    `large_client_header_buffers` 的单个 8k 缓冲。** 官方文档明写「请求行放不进
    #    **一个**缓冲就返 414」⇒ 必须调大**单个**尺寸，调多个数量没用。
    #    不加这条的形态：小批快照正常、满批恒 414，且**请求根本到不了 shim**，
    #    在上游日志里查不到任何痕迹。
    large_client_header_buffers 4 16k;

    # ── 闸 1：身份 ──────────────────────────────────────────────────────────
    # map 没命中 ⇒ $guest_name 为空 ⇒ 401。注意这是**认证**失败,不是授权失败。
    if ($guest_name = "") {
        return 401 '{"error":"unauthorized"}';
    }

    # ── 闸 4：token 置换（server 级，所有 location 继承）────────────────────
    # 访客带的是自己的 bearer;上游收到的是 shim 的真 token。访客永远拿不到它。
    #
    # 🚨 **放在 server 级而不是各 location 里，是为了让它漏不掉。** 这一条是本代理存在
    #    的全部理由；留在 location 级的话，加新端点时漏抄一行就会把访客自己的 bearer
    #    原样转上去。那不是安全洞（shim 会 401，fail-closed），但报错方向完全错 ——
    #    看到的是「这个访客的 token 不对」，而真因是代理少了一行。
    #
    # 🚨 **nginx 的 `proxy_set_header` 是整组覆盖，不是逐条合并**：任何一个 location
    #    里只要出现**一条** `proxy_set_header`，server 级这三条就**全部**对该 location
    #    失效。⇒ 要给某个端点单加 header，必须把这三条一起抄过去。这条规则不显眼，
    #    但踩中的形态正是上面那个「token 没置换」。
    proxy_set_header Authorization "Bearer ${FUTU_SHIM_TOKEN}";
    proxy_set_header Host $host;
    proxy_set_header X-Guest $guest_name;

    proxy_connect_timeout 10s;
    # OpenD 自 2026-08-04 (#868) 改为**常驻**,正常路径不再有冷启等待。
    # 90s 仍然保留,是给「OpenD 崩溃后被 Restart=always 拉起」这个窗口留的余量
    # (冷启实测 15-25s) —— 读超时容不下时访客侧看到的是 504 而非慢。
    proxy_read_timeout 90s;

    # ── 闸 2：端点白名单 ───────────────────────────────────────────────────
    # 开 /capabilities + /kline + 期权链三条 + 标的级 /overview + 标的注册表两条。
    # /his-vol /universe /trading-days /earnings-calendar 一律不可见。面越小越好;要放新端点
    # 是显式动作,不是默认继承。
    # ⚠️ 上游 shim 自己也有一条 `/universe`,与本文放行的 `/instrument-codes` **不是一回事**
    #    （那条查的是富途的标的全集,这两条读的是 mono 的注册表）—— 别因为名字像就把它一起开。
    #
    # 🚨 **加 location 就必须同步 capabilities/capabilities.md** —— 两侧集合相等由
    #    `deploy/install.sh` 的 Gate A 机器强制,写漏一个部署直接红。这不是提醒,是闸。

    # ── 能力目录:访客手里的 skill 是薄壳,端点清单在这里下发 ─────────────────
    # 它存在的全部理由:以前加一个端点要重新打包 skill 并线下发给访客,访客手里那份
    # 必然滞后。现在端点清单随部署走网络,访客的 skill 装一次就不用再动。
    #
    # 🚨 **不挂 limit_req zone,这是刻意的。** 上面四个 zone 护的是两种真成本:
    #    ①②③ 护上游 vendor 的官方限额(给访客多少 prod 就少多少)、④ 护本机磁盘
    #    (请求 body 整份落盘)。本端点读的是本地一个几 KB 的静态文件,不打上游、
    #    不落盘、不耗任何配额 —— 两种成本一条都不沾。多一个 zone 就是多一份要维护的
    #    东西,收益为零。
    #
    # ⚠️ **`default_type` 必须在这里覆盖。** server 级钉的是 `application/json`(那是给
    #    所有 proxy_pass 端点的),不覆盖的话本文会带着 JSON 的 Content-Type 发出去。
    #
    # 🚨 **`charset utf-8` 单写是个 no-op,必须配 `charset_types`。** nginx 的 `charset`
    #    只对 `charset_types` 名单里的 MIME 生效,而该名单默认是
    #    `text/html text/xml text/plain text/vnd.wap.wml application/javascript
    #    application/rss+xml` —— **不含 `text/markdown`**。2026-08-16 本机实测:只写
    #    `charset utf-8` 时响应头是光秃秃的 `Content-Type: text/markdown`,一个 charset
    #    参数都没有。正文大量中文,发给不默认按 UTF-8 解的客户端就是乱码,而**字节本身是对的**
    #    ⇒ 这种坏法在服务端侧完全看不出来。
    #
    # ⚠️ **这里绝对不要写 proxy_set_header** —— 同 /healthz 那条的理由。本 location 根本
    #    不 proxy,写了没用;但真正的风险是有人照抄时把它带进别处,那会整组覆盖掉 server
    #    级那三条(含 token 置换)。
    #
    # ℹ️ ETag / Last-Modified 由 nginx 对静态文件自动生成(`etag` 默认 on),访客侧的条件
    #    请求因此免费可用。**刻意不在正文里手写版本号** —— 那是典型的「改内容忘了改号」
    #    漂移源,而 77 上的 /opt/nvy-guest-proxy/VERSION 已经记着本次部署的 SHA。
    location = /capabilities {
        default_type text/markdown;
        charset_types text/markdown;
        charset utf-8;
        alias /etc/nvy-guest-capabilities/capabilities.md;
    }

    location = /kline {
        # ── 闸 3：市场白名单 ────────────────────────────────────────────────
        # 🔴 只放 US。理由是**最小权限**，不是行情权风险 —— V10（08-04 港股早市实测）
        #    已证伪「OpenD 抢走手机行情权」，那条旧理由已作废。访客的用途就是美股，
        #    一个只放行实际需要的市场的白名单本身就比「怕降级所以挡」更耐久。
        #    **要给访客开港股是一个独立决策**，改这条正则即可，别当成 V10 的连带后果。
        #
        # nginx 的 $arg_code 与 Flask 的 request.args.get('code') 在重复参数时
        # **都取第一个**,所以 ?code=US.X&code=HK.Y 不构成绕过 —— 两侧看到的是
        # 同一个值。这一点是本闸成立的前提,改动前先复核。
        if ($arg_code !~ "^US\.") {
            return 400 '{"error":"bad_request","detail":"code must start with US. (guest access is US-only)"}';
        }

        limit_req zone=guest_kline burst=15 nodelay;

        proxy_pass ${FUTU_SHIM_URL}/kline$is_args$args;
    }

    # ── 期权面（2026-08-04 开放）───────────────────────────────────────────
    # 三条端点对应一条链路：**有哪些到期日 → 那些到期日上有哪些合约 → 这些合约现在多少钱**。
    # 单靠其中任意一条都用不起来，所以要开就是三条一起开。
    #
    # 🔴 `/earnings-calendar` **刻意不开**（不是遗漏）：它的参数是 `market=US`、
    #    **连 code 都没有** ⇒ 闸 3 在结构上够不到它；而且它是市场级全量接口，返回的是
    #    全市场财报日历，与「美股期权」这个用途无关。要开它得先给它设计一道自己的闸，
    #    那是一个独立决策。
    location = /option-expirations {
        # 单 code 端点，与 /kline 同形态。
        if ($arg_code !~ "^US\.") {
            return 400 '{"error":"bad_request","detail":"code must start with US. (guest access is US-only)"}';
        }

        limit_req zone=guest_option_meta burst=5 nodelay;

        proxy_pass ${FUTU_SHIM_URL}/option-expirations$is_args$args;
    }

    location = /option-chain {
        if ($arg_code !~ "^US\.") {
            return 400 '{"error":"bad_request","detail":"code must start with US. (guest access is US-only)"}';
        }

        # 🔴 上游最紧的池（算账见顶部 zone ②）。burst 给 3 而不是 5，是让「一只票的
        #    整条到期日阶梯」（约 5-8 个 30 天窗）前几发能连着过，又不至于一口气把
        #    prod 那侧的余量吃掉。
        limit_req zone=guest_option_chain burst=3 nodelay;

        proxy_pass ${FUTU_SHIM_URL}/option-chain$is_args$args;
    }

    location = /option-snapshot {
        # ── 闸 3（复数参数版）：两步，顺序不能反 ────────────────────────────
        # 本端点的参数是 **`codes`（复数、逗号分隔）**，`$arg_code`（单数）在这里恒为空
        # ⇒ 上面那条单数写法**对它完全不生效**，必须单写。照抄单数版的形态 =
        # 闸看着在、实际恒放行。
        #
        # 🚨 **步骤 ① 存在的唯一理由是百分号编码绕过，不是洁癖。**
        #    nginx 的 `$arg_*` **不做 URL 解码**。`codes=US.PEP%2CHK.700` 在这里是一个
        #    **不含字面逗号**的串 ⇒ 只写步骤 ② 的话，它会被当成单个 code、`^US\.` 匹配
        #    通过、**放行**；而 Flask 侧 `request.args` 会把它解码成 `US.PEP,HK.700`，
        #    shim 按逗号切开 —— 港股就这么进去了，且日志里看着像一次合法请求。
        #    字符集白名单先把 `%` 拒掉，步骤 ② 才成立。**两步是一个整体，别拆。**
        if ($arg_codes ~ "[^A-Za-z0-9.,\-]") {
            return 400 '{"error":"bad_request","detail":"codes contains an illegal character (letters, digits, dot, hyphen, comma only; percent-encoding is rejected)"}';
        }

        # 步骤 ②：**每一段**都必须是 `US.`，不是「开头是 US. 就行」。
        # `^US\.` 那种写法会放过 `US.PEP,HK.700`。
        if ($arg_codes !~ "^US\.[^,]+(,US\.[^,]+)*$") {
            return 400 '{"error":"bad_request","detail":"every code must start with US. (guest access is US-only)"}';
        }

        limit_req zone=guest_option_meta burst=5 nodelay;

        proxy_pass ${FUTU_SHIM_URL}/option-snapshot$is_args$args;
    }

    location = /overview {
        # 标的级期权总览：iv / iv_rank / iv_percentile + HV 梯队,一发 ≤500 个标的。
        # 对做卖方的人,IV 分位比链本身更常用,而这条一次调用就覆盖整个自选池。
        #
        # ⚠️ **两步 codes 闸是从 /option-snapshot 抄过来的,两份必须同步改。**
        #    没抽成 map 是刻意的:本文件里单数版的 `if ($arg_code !~ "^US\.")` 同样在三个
        #    location 里各写一份,与既有风格一致;而且两步各自的诊断文案对访客侧的模型有用,
        #    合并成一条会丢掉「别做百分号编码」这个具体指引。
        #    **复制的安全阀是 verify-guards.sh 给本端点单配了反例断言** —— 抄漏或改漂了会红。
        if ($arg_codes ~ "[^A-Za-z0-9.,\-]") {
            return 400 '{"error":"bad_request","detail":"codes contains an illegal character (letters, digits, dot, hyphen, comma only; percent-encoding is rejected)"}';
        }
        if ($arg_codes !~ "^US\.[^,]+(,US\.[^,]+)*$") {
            return 400 '{"error":"bad_request","detail":"every code must start with US. (guest access is US-only)"}';
        }

        # 与 /option-expirations · /option-snapshot 共用 meta 池：三者的上游官方限额同为
        # 60 次/30s。**不给它单开 zone** —— prod 侧消费它的 `underlying_iv_daily` 维度
        # 一天只打 1-2 发（≤500 codes 一次批完），争用可以忽略,不值得再多一个池要维护。
        limit_req zone=guest_option_meta burst=5 nodelay;

        proxy_pass ${FUTU_SHIM_URL}/overview$is_args$args;
    }

    # ── 标的注册表 —— 本代理上第一条**读 mono** 的端点 ────────────────────────
    #
    # 上面行情面打的是港机 shim；下面研报 / 锚打的是本机 mono，但**全是写**。这两条是
    # 读 mono：访客问「这个市场有哪些标的、它们叫什么」。开它的动机很具体 —— 下面两条写口
    # 都要求调方先知道 canonical `market:code`，而在此之前通道上**没有任何地方能告诉他**，
    # 只能猜；猜错会静默落到另一只票上。
    #
    # 🚨 **market 是独立参数，闸的形态与本文件其它所有市场闸都不同**：行情面是 `^US\.`
    #    前缀匹配、锚是 `^(us|hk):` 前缀匹配，这里是 `^(cn|hk|us)$` **两端锚定的全值匹配**。
    #    少写尾锚 `$` 就放过 `usx` / `us%00` 一类。**别照抄邻居改齐。**
    #
    # 🚨 **三个市场全放，与行情面的 US-only 刻意不同**，同样别改齐：那边收窄是因为每一发都
    #    在切富途的官方限额（给访客多少 prod 就少多少）；本面读的是本机 PG 里的上市元数据，
    #    不打上游、不耗任何配额 —— 收窄只会让通道对一半标的不可用。判据与 /research-report
    #    同源（研报库同样收三个市场），不与 /kline 同源。
    #
    # ⚠️ 与 server 侧是**两份独立文本、会漂**：服务端那份的单点在
    #    `apps/server/src/marketdata/instrument-query.rules.ts`。钉住两侧的是那边的单测 +
    #    IT 的三市场断言（服务端一半）与本目录 `verify-guards.sh` 闸 9 的反例（通道一半）。
    location = /instrument-codes {
        # ── 闸 A：只放 GET（059「只放 POST」那条的镜像）─────────────────────
        # 服务端同样没实装任何写动作，但两层各拒一次、不依赖对方：某天有人在这个前缀下加了
        # 写端点，光靠「服务端恰好没实现」就直接对访客开放了。
        # ⚠️ 干活的是 `deny` ⇒ 返回 **403 不是 405**（057 真跑证伪过 405 这个直觉）。
        limit_except GET { deny all; }

        if ($arg_market !~ "^(cn|hk|us)$") {
            return 400 '{"error":"bad_request","detail":"market must be exactly one of cn / hk / us (lowercase, in the query string)"}';
        }

        limit_req zone=guest_instr_codes burst=2 nodelay;

        # ── gzip：是本端点成立的前提，不是锦上添花 ──────────────────────────
        # 美股全量实测 158 KB → 49 KB（3.2×）。mono 侧**没有装 `@fastify/compress`** ⇒ 上游
        # 发的是明文，压缩只能在这里做。
        # 🚨 nginx 的 `gzip` 默认 **off**、`gzip_types` 默认只有 `text/html` ⇒ 这两条都必须
        #    显式写，少任何一条都是「配了等于没配」，而**两侧都不会报错**。
        # ⚠️ `gzip_proxied any` 在当前拓扑下其实用不上（该指令只在请求带 `Via` 头时生效，
        #    访客是直连本机的）。写上是为了将来本代理若被塞到另一层代理后面时不静默停止压缩。
        # 🚨 **访客不带 `Accept-Encoding` 就没有压缩** —— curl 必须加 `--compressed`。能力
        #    目录的示例命令写死了它，`verify-guards.sh` 闸 9 断言响应头真有 `Content-Encoding`。
        gzip on;
        gzip_types application/json;
        gzip_proxied any;
        gzip_vary on;
        gzip_min_length 1024;

        # ── token 置换（整组三条，理由同 /research-report）────────────────
        proxy_set_header Authorization "Bearer ${GUEST_UPLOAD_TOKEN}";
        proxy_set_header Host $host;
        proxy_set_header X-Guest $guest_name;

        proxy_pass http://127.0.0.1:3001/api/v1/marketdata/instrument-codes$is_args$args;
    }

    location = /instrument-basics {
        limit_except GET { deny all; }

        # 市场闸与上面同源同文本（两条 location 各写一份，与本文件既有风格一致 ——
        # `/kline` 与 `/overview` 的 US-only 也是各写各的）。
        if ($arg_market !~ "^(cn|hk|us)$") {
            return 400 '{"error":"bad_request","detail":"market must be exactly one of cn / hk / us (lowercase, in the query string)"}';
        }

        # ── codes 字符集闸 ─────────────────────────────────────────────────
        # 🚨 **只有一步，不是两步 —— 别照抄 /option-snapshot 那道两步闸。** 那里的步骤 ②
        #    （「每一段都必须 `US.`」）防的是跨市场混批；本端点的 market 是**独立参数**，
        #    一发只查一个市场，混批在结构上不可能。抄过来只会拒掉合法请求。
        # 🚨 字符集这一步一个字都不能少，它的全部意义是**百分号编码绕过**：`$arg_*` 不解码，
        #    `codes=AOS%2CPEP` 在这里是一个不含字面逗号的单段串。
        # 🚨 **本字符集比 /option-snapshot 那份宽，这是实测决定的、不是手滑**：2026-08-22 实测
        #    registry 美股侧有 112 条真实 code 落在那份窄集合之外 —— `_` 97 条（`WFC_Z`）、
        #    `*` 13 条（`BHVN*`）、`/` 1 条（`PSUS/PS`）、`-` 1 条。抄窄的那份会把
        #    **/instrument-codes 自己刚发出去的串**拒掉，而访客永远查不出原因。
        #    与 server 侧 `INSTRUMENT_CODE_PATTERN` 同源，改一处必改另一处。
        if ($arg_codes ~ "[^A-Za-z0-9.,_/*-]") {
            return 400 '{"error":"bad_request","detail":"codes contains an illegal character (letters, digits, dot, hyphen, underscore, slash, star, comma only; percent-encoding is rejected)"}';
        }

        limit_req zone=guest_instr_basics burst=5 nodelay;

        # 同上：一发 500 个标的的基础信息也有几十 KB，且 curl 必须 --compressed。
        gzip on;
        gzip_types application/json;
        gzip_proxied any;
        gzip_vary on;
        gzip_min_length 1024;

        proxy_set_header Authorization "Bearer ${GUEST_UPLOAD_TOKEN}";
        proxy_set_header Host $host;
        proxy_set_header X-Guest $guest_name;

        proxy_pass http://127.0.0.1:3001/api/v1/marketdata/instrument-basics$is_args$args;
    }

    # 存活探针。不碰 OpenD(shim 侧 /healthz 明确 never starts OpenD),
    # 访客用它确认隧道通不通,不用去猜。
    # ⚠️ 这里**不要**写 proxy_set_header —— 写一条就会丢掉 server 级那三条（含 token
    #    置换），表现为 /healthz 恒 401 而 /kline 正常。
    location = /healthz {
        proxy_pass ${FUTU_SHIM_URL}/healthz;
    }

    # ── 研报投递（057）—— 本代理上唯一一条**写**端点，也是唯一一条不打 shim 的 ────
    #
    # 它转给**本机的 mono app**（compose 给 app 开的 loopback-only 端口 127.0.0.1:3001），
    # 不是港机的 shim。上面所有端点都是「读行情」，这条是「往收集箱里放东西」。
    location = /research-report {
        # ── 闸 A：只放 POST ────────────────────────────────────────────────
        # 服务端本就没实装任何读取动作，但**这条不能省**：那是会被未来某个 PR 悄悄打破的
        # 状态（有人加了内部 list 端点、路径前缀一样，就直接对访客开放了）。两层各拒一次，
        # 不依赖对方（FR-013）。
        limit_except POST { deny all; }

        # ── 闸 B：市场白名单 ────────────────────────────────────────────────
        # 🔴 **与上面行情端点的 US-only 刻意不同**，别当成不一致改齐：行情那条只放 US 是
        #    「访客的用途就是美股」的最小权限；而研报库按 PRD 覆盖 A股/港股/美股三个市场，
        #    收窄到 US 会让这条通道对一半标的不可用。两处的判据本来就不是同一个。
        #
        # ⚠️ `$arg_*` **不解码** ⇒ 投递方若把冒号写成 `%3A`，这里撞不上、直接 400。
        #    方向是 fail-closed（安全），但错误文案必须写明「不要编码」，否则 agent 会
        #    反复试错烧限频（skill 文案 T014 同步写明）。
        if ($arg_symbol !~ "^(cn|hk|us):") {
            return 400 '{"error":"bad_request","detail":"symbol must start with cn:/hk:/us: (do NOT percent-encode the colon)"}';
        }

        # ── 闸 C：体积 ─────────────────────────────────────────────────────
        # 四层天花板由外到内：**本行 20m** > OSS content-length-range 17MB >
        # multipart fileSize 16MB。刻意让**中间那层先跳闸** —— 只有 multipart 那层能给出
        # 干净的 ProblemDetail；本行跳闸给的是 413 + HTML 页，且 server 日志里什么都没有，
        # 是三层里最难诊断的一个。全仓此前零处设置本指令，默认 1m ⇒ 不加这行必然恒 413。
        client_max_body_size 20m;

        limit_req zone=guest_upload burst=1 nodelay;

        # ── 闸 D：token 置换（整组三条）───────────────────────────────────
        # 🚨 `proxy_set_header` 是**整组覆盖**：这里只要出现一条，server 级那三条就全部
        #    对本 location 失效 ⇒ 必须整组抄。Authorization 换成 **mono 侧的**
        #    `GUEST_UPLOAD_TOKEN`（不是 shim 的那把）—— 照抄 FUTU_SHIM_TOKEN 不是安全洞
        #    （app 侧 401 fail-closed）但排障方向完全错：看到的是「这个 guest token 不对」，
        #    真因是代理少改了一行。
        proxy_set_header Authorization "Bearer ${GUEST_UPLOAD_TOKEN}";
        proxy_set_header Host $host;
        proxy_set_header X-Guest $guest_name;

        # 上传比读行情慢得多（2MB 走隧道 + server 再转 OSS），读超时给足。
        proxy_read_timeout 120s;

        proxy_pass http://127.0.0.1:3001/api/v1/research/reports$is_args$args;
    }

    # ── 锚模型导入（059）—— 本代理上**唯一一条能改业务数据**的端点 ─────────────
    #
    # 上面那条研报是「往收集箱里放东西」，这条是**直接改库里的估值锚**。差别不在实现上，
    # 而在于：它必须多一道**授权**闸 —— 认证（你是谁）在 server 级已经做了，这里判的是
    # 「你能不能干这件事」。两者别混：认证过了不等于有权直写。
    location = /anchor-import {
        # ── 闸 A：只放 POST ────────────────────────────────────────────────
        # 服务端同样没实装任何读取动作，但两层各拒一次、不依赖对方（FR-013）。
        # ⚠️ 干活的是 `deny` ⇒ 返回 **403 不是 405**（057 真跑证伪过 405 这个直觉）。
        limit_except POST { deny all; }

        # ── 闸 B：授权（本片新增，FR-010）───────────────────────────────────
        # 🚨 **只有本人可以直接写锚**。其他访客认证得过（他们有自己的 bearer），但到这里
        #    被 403 —— 他们的路径是下面那条 /anchor-submit，落待审表、锚表零变化。
        #    判据取自 http 级的 `$anchor_write_allowed` map（env 化，不硬编码名字）。
        # 🚨 **这一行是整条链上唯一的授权判据**：本口与 /anchor-submit 转发同一把 bearer
        #    （见下面闸 E）⇒ 服务端收到后无法区分它俩。删掉 / 改错这三行 = 任何访客都能
        #    直写锚，而且**服务端不会红、日志也不会响** —— 唯一的回归钉是
        #    `verify-guards.sh` 的锚导入闸（他人 → 403 那条）。
        if ($anchor_write_allowed = "0") {
            return 403 '{"error":"forbidden","detail":"direct anchor writes are owner-only; use /anchor-submit instead"}';
        }

        # ── 闸 C：市场白名单 ────────────────────────────────────────────────
        # 🚨 **与 server 侧 DTO 同源，改一处必改另一处**：服务端那份的单点在
        #    `apps/server/src/optionsdesk/anchor-import.rules.ts`（`IMPORTABLE_MARKETS`）。
        #    两份文本会漂，钉住它的是 server IT 里对 `cn:` 的 400 断言 + 本目录
        #    `verify-guards.sh` 的同名反例 —— 谁改单边，那两条里必有一条红。
        # ⚠️ `$arg_*` **不解码** ⇒ 冒号写成 `%3A` 会撞不上、直接 400（fail-closed），
        #    错误文案必须写明「不要编码」，否则 agent 会反复试错烧限频。
        if ($arg_ticker !~ "^(us|hk):") {
            return 400 '{"error":"bad_request","detail":"ticker must start with us:/hk: and live in the query string (do NOT percent-encode the colon)"}';
        }

        # ── 闸 D：体积 ─────────────────────────────────────────────────────
        # body 是五个短标量的 JSON，几百字节；4k 已是宽松上界。写这行不是防大文件，
        # 是把「拿这个口传大 body」这条路直接堵死（默认值 1m 对本端点毫无意义）。
        client_max_body_size 4k;

        limit_req zone=guest_anchor burst=2 nodelay;

        # ── 闸 E：token 置换（整组三条）───────────────────────────────────
        # 🚨 `proxy_set_header` 是**整组覆盖**：这里出现一条，server 级那三条就全部对本
        #    location 失效 ⇒ 必须整组抄。
        # 🚨 Authorization 换成 **mono 侧的** `GUEST_UPLOAD_TOKEN`（不是 shim 的那把）。
        #    与 /research-report、/anchor-submit 是**同一把** —— 059 曾给本口单独发过第二把
        #    token，收口时回退（理由在 mono 的 config/guest-upload.config.ts 顶部）。
        # 🚨 后果就在上面的闸 B：服务端收到本口与 /anchor-submit 的请求**无法区分**，
        #    「只有本人可直写」整条判据只剩闸 B 这一处。删闸 B = 任何访客都能直写锚。
        proxy_set_header Authorization "Bearer ${GUEST_UPLOAD_TOKEN}";
        proxy_set_header Host $host;
        proxy_set_header X-Guest $guest_name;

        proxy_pass http://127.0.0.1:3001/api/v1/optionsdesk/anchors/model-import$is_args$args;
    }

    # ── 锚估值提交（059）—— 他人的入口：只进待审收件箱，锚表零变化 ─────────────
    # 与上面同形，**去掉授权闸**（谁都能提交）、独立限频；bearer 与上面同一把。
    location = /anchor-submit {
        limit_except POST { deny all; }

        # 市场闸与上面同源同文本 —— 两条 location 各写一份，与本文件既有风格一致
        # （`/kline` 与 `/overview` 的 US-only 也是各写各的）。
        if ($arg_ticker !~ "^(us|hk):") {
            return 400 '{"error":"bad_request","detail":"ticker must start with us:/hk: and live in the query string (do NOT percent-encode the colon)"}';
        }

        # 比直写口宽一点：附言是自由文本。仍然是「堵死大 body」这一个目的。
        client_max_body_size 8k;

        limit_req zone=guest_anchor_submit burst=1 nodelay;

        # 🚨 与 /anchor-import 是**同一把** —— 服务端因此分不出这两条路径，别以为这里
        #    还有第二道保险。
        proxy_set_header Authorization "Bearer ${GUEST_UPLOAD_TOKEN}";
        proxy_set_header Host $host;
        proxy_set_header X-Guest $guest_name;

        proxy_pass http://127.0.0.1:3001/api/v1/optionsdesk/anchors/submissions$is_args$args;
    }

    # 其余一律不存在。放在最后,前面几个 = 精确匹配优先。
    location / {
        return 404 '{"error":"not_found"}';
    }
}
