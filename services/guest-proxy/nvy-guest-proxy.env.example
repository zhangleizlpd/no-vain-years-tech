# 访客代理的环境文件。装到 77 的 /etc/nvy-guest-proxy.env（0600 root:root）。
#
# 🚨 **本文件含真 token，永不入库**。仓里这份是模板（值全是 __FILL_ 占位）。
#    渲染方式见 runbook 步骤 4 —— 用 `sops exec-env` 让真值只经内存，
#    **别手工把 token 粘进终端**（会进 shell history，且容易粘到别的窗口）。
#
# ── 加一个访客要改哪几处（2026-08-04 收敛到两处）───────────────────────────────
#   1. **本文件**：照下面 GUEST2 的样子加一组 GUESTn_TOKEN / GUESTn_NAME
#   2. **nginx template 的 map**：加一行 "Bearer ${GUESTn_TOKEN}" "${GUESTn_NAME}";
#
#   其余两处已泛化、**不用再动**：
#   · `render-env.sh` 从本模板里**发现** __FILL_GUESTn_TOKEN__ 占位并逐个填，无硬编码
#   · deploy 侧不再有任何 envsubst 白名单（2026-08-17 删除，见 deploy/install.sh 文件头）
#
#   ⚠️ nginx 的 map 没有通配写法，第 2 处只能逐个加 —— 漏了的表现是那个访客恒 401。

# 上游 shim。走 wg1 隧道虚 IP —— 不是 localhost，server 与 shim 从 day 1 就不同机。
FUTU_SHIM_URL=http://10.89.0.1:8811

# shim 的真 token。来源 = secrets.enc.env 的 FUTU_SHIM_TOKEN。
# 🚨 **它设计上永不轮换**（换它要连 prod SOPS 一起改并重部署）⇒ 绝不发给任何人。
#    访客拿到的是下面那些 GUESTn_TOKEN，两者无关。
FUTU_SHIM_TOKEN=__FILL_FUTU_SHIM_TOKEN__

# 转发给**本机 mono app** 时用的 bearer。来源 = secrets.enc.env 的 GUEST_UPLOAD_TOKEN，
# 与上面 shim 那把、与下面访客那些**三者互不相干**。
# 059 起**一把管三条 location**：研报投递 / 锚待审提交 / 锚直写。刻意不拆第二把（理由与
# 「要加回第二把的门槛」单点在 mono 的 apps/server/src/config/guest-upload.config.ts 顶部）
# ⇒ 服务端分不出直写与提交，**「谁能直写锚」全靠下面的 ANCHOR_OWNER_NAME**。
# 🚨 它必须与 mono 侧 SOPS 里的值**逐字节一致** —— 所以走 FUTU_SHIM_TOKEN 那条路径
#    （从 sops 注入的 env 取），**不是** __FILL_GUESTn_TOKEN__ 那条自动发现路径
#    （那条会 `openssl rand` 现生成，现生成的值 mono 侧永远对不上，表现为恒 401）。
GUEST_UPLOAD_TOKEN=__FILL_GUEST_UPLOAD_TOKEN__

# 有权**直写锚**的访客名（059）。取值 = 下面某个 GUESTn_NAME 的值（不是 token）。
# 🚨 **这是「只有本人可直写锚」唯一的授权判据**（见上）—— 不是「多一道保险」，是那道闸本身。
# 🚨 它不是秘密（nginx map 的 key、access log 里本就打印），但**空值会让直写口恒 403** ——
#    方向 fail-closed、可接受，但要能一眼看出来，故 render-env.sh 断言它非空。
# ⚠️ 改访客名时这里要跟着改：漏改的表现是本人自己被 403。
ANCHOR_OWNER_NAME=__FILL_ANCHOR_OWNER_NAME__

# ── 访客 1（运维 Mac，wg2 10.90.0.2）──────────────────────────────────────────
# 发给访客的 bearer。**现生成，与上面那个无关**：`openssl rand -hex 24`
# 吊销/轮换 = ROTATE=GUEST1_TOKEN FORCE=1 重跑 render-env.sh + `systemctl reload
# nvy-guest-proxy`，不牵连任何其他访客。
GUEST1_TOKEN=__FILL_GUEST1_TOKEN__
# access log 里的可读名字（`guest=` 字段）。
GUEST1_NAME=friend1

# ── 访客 2（朋友，wg2 10.90.0.3）──────────────────────────────────────────────
GUEST2_TOKEN=__FILL_GUEST2_TOKEN__
GUEST2_NAME=friend2
