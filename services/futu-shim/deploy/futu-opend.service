# Futu OpenD gateway — RESIDENT. systemd owns its lifetime; futu-shim is its
# only client and, under the resident default, never stops it.
#
# It used to be demand-driven, and this file used to carry no [Install] section
# on purpose so that `systemctl enable` would fail. That guard existed for
# exactly one reason: "a resident OpenD permanently holds the account's top-tier
# quote entitlement (auto_hold_quote_right=1) and degrades the owner's phone app
# for as long as it runs."
#
# That claim was never measured, and it misread the vendor docs — OpenD grabs the
# entitlement back *after* being pre-empted; it does not seize it on startup. Two
# experiments then falsified it outright: 2026-08-03 (US session) and 2026-08-04
# (HK session — the one market whose LV2->BMP downgrade the vendor actually
# documents). In both, the phone app contended hard against a live OpenD
# subscription and both sides kept their top tier throughout; the permission
# event fires once at startup and never again. See p3b §4.3 requirement 5 and
# §7.3-V9 / V10 in docs/private/plans/2026-07/07-30-sellput-viz-p3b-data-architecture.md.
#
# Reverting to windowed operation: set FUTU_OPEND_IDLE_STOP_S > 0 in
# /etc/futu-shim.env and restart futu-shim — it resumes reaping, and an explicit
# `systemctl stop` does NOT trip Restart=always, so the two settings do not
# fight. The unit stays enabled either way, so a reboot still starts OpenD once
# and the shim reaps it one idle period later. That asymmetry is deliberate:
# the env var is the fast rollback, a clean revert is a redeploy.

[Unit]
Description=Futu OpenD gateway (resident; futu-shim is its only client)
After=network-online.target
Wants=network-online.target

# Crash-loop backstop for Restart=always below: five starts per five minutes,
# after which the unit stays failed instead of retrying a broken login against
# the vendor forever. A failed unit makes the shim's `systemctl start` fail
# loudly (OpenDUnavailable -> HTTP 5xx -> SyncRun.failed_targets), which is the
# failure shape we want. Recovery after fixing the cause is
# `systemctl reset-failed futu-opend` — see ops/runbook/futu-opend-hk.md.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/opt/FutuOpenD
ExecStart=/opt/FutuOpenD/FutuOpenD -cfg_file=/opt/FutuOpenD/FutuOpenD.xml

# REQUIRED. OpenD unconditionally opens an interactive console on stdin and
# swallows whatever it is handed; without this it consumes the manager's stdin
# and spins repainting its prompt. Measured 2026-07-31.
StandardInput=null

# StandardOutput=null is deliberate: that console is pure noise, not diagnostics.
# Measured 2026-08-01 on one session's capture (18,718,720 bytes): 507 lines were
# >10 KB each — every one of them the prompt repainting itself as ">>>" plus space
# padding, up to 65,278 chars per line, with zero business keywords. Capturing it
# cost ~18 MB per OpenD run (~550 MB/month) and carried no information.
#
# The real log is OpenD's own: $HOME/.com.futunn.FutuOpenD/Log/GTWLog_*.log —
# timestamped, levelled, component-tagged, 7-52 KB per session, and it already
# contains everything the console echoed (verified: 登录成功, 美股: LV3,
# 权限状态, 订阅额度 all present). Retention for that dir is handled by
# /etc/logrotate.d/futu-opend on the host — see ops/runbook/futu-opend-hk.md §五.
#
# stderr still goes to the journal so a genuine startup failure stays visible;
# journald caps itself, so there is nothing to rotate.
StandardOutput=null
StandardError=journal

# Resident: survive a crash without waiting for the next request. RestartSec is
# 10 s rather than the 100 ms default so a persistent failure walks into the
# StartLimit above in ~40 s instead of burning hundreds of login attempts first.
Restart=always
RestartSec=10
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
