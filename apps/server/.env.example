# Copy this file to .env (gitignored) and fill in real values for local dev.
# Spec for required env vars; checked into git for new-dev onboarding.
# All values parsed by Zod at boot (apps/server/src/config/*.config.ts) —
# missing or malformed → boot fails before listen.

# --- App ---
# 'development' | 'test' | 'production' (defaults to development)
NODE_ENV="development"
# Listen port (1–65535, default 3000)
PORT="3000"
# pino log level: trace | debug | info | warn | error | fatal (default info)
LOG_LEVEL="info"
# CORS allow-list. '*' = permissive (dev only); 'https://a.com,https://b.com' = strict.
# Empty / unset → no Access-Control-Allow-Origin emitted (lock-down).
# Production recommended (Cloudflare Pages host per ADR-0025;
# see docs/experience/2026-05/05-22-cloudflare-pages-deploy-mono.md):
#   CORS_ALLOWED_ORIGINS="https://app.shintongtech.com,https://no-vain-years-mono.pages.dev"
# Preview branch wildcards (*.no-vain-years-mono.pages.dev) currently NOT
# supported — parseOrigins handles literal strings only. Add specific preview
# origins on demand, or extend parseOrigins to recognize regex when needed.
CORS_ALLOWED_ORIGINS="*"

# --- Datastore ---
# PostgreSQL: docker-compose.dev.yml mbw-poc-postgres (port 5433).
DATABASE_URL="postgresql://mbw:mbw@localhost:5433/mbw_poc"

# Redis: docker-compose.dev.yml mbw-poc-redis (port 6380).
REDIS_URL="redis://localhost:6380"

# --- Auth secrets ---
# JWT HS256 secret — min 32 bytes. Replace via secrets manager in prod.
AUTH_JWT_SECRET="dev-only-secret-for-phone-sms-auth-32B-pad-xyzabc"

# SMS code HMAC-SHA256 secret — per ADR-0023, min 32 bytes. Replace via
# secrets manager in prod. Rotation policy: deprecation window ≥ 5min TTL
# so old-hash verify naturally expires before new-secret-only verify takes over.
SMS_CODE_HMAC_SECRET="dev-only-hmac-secret-for-sms-code-32B-zzzzzz"

# --- SMS gateway ---
# 'mock' (default; dev/test) | 'aliyun' (prod). When 'aliyun', all 4 ALIYUN_*
# values below are required and validated at boot (sms.config.ts).
SMS_GATEWAY="mock"
# When SMS_GATEWAY=aliyun these 4 are required (Zod throws at boot otherwise).
# Leave blank for mock mode.
ALIYUN_ACCESS_KEY_ID=""
ALIYUN_ACCESS_KEY_SECRET=""
ALIYUN_SMS_SIGN_NAME=""
ALIYUN_SMS_TEMPLATE_CODE=""
# Optional dedicated templates for 注销 / 撤销注销 codes (FR-S05/S08, 004).
# Blank → AliyunSmsGateway falls back to ALIYUN_SMS_TEMPLATE_CODE (login template).
ALIYUN_SMS_TEMPLATE_CODE_DELETE_ACCOUNT=""
ALIYUN_SMS_TEMPLATE_CODE_CANCEL_DELETION=""

# --- WeChat account binding (per apps/server/src/config/wechat.config.ts; 010) ---
# 'mock' (default; Phase 1 port-stub) | 'real' (Phase 2 OAuth). prod forbids mock.
WECHAT_GATEWAY="mock"
# When WECHAT_GATEWAY=real these 2 are required (Zod throws at boot otherwise).
WECHAT_APP_ID=""
WECHAT_APP_SECRET=""

# --- IP geolocation (ip2region) ---
# Optional override for the ip2region .xdb data file path. Blank → resolveXdbPath()
# falls back to the bundled candidate paths (src/security/data | dist/security/data).
IP2REGION_XDB_PATH=""

# --- Object storage (Aliyun OSS — 009 profile image upload, per ADR-0045/0037) ---
# All-or-nothing: leave all four blank in dev/test → oss.config kind='unconfigured'
# (boot stays green, credential issuance unavailable). Set all four to enable.
# Creds = Aliyun *account C* (nvy-profile-uploader), minimal oss:PutObject on the
# avatar/ + background/ + ideation/ + ideation-mockup/ prefixes. Distinct from
# both the SMS ALIYUN_* (account A) and the research RESEARCH_OSS_* (also account
# C, but a second AK whose scope is disjoint — research/ only).
# Provisioning + deploy injection: docs/private/plans/2026-05/05-31-oss-provisioning-runbook.md
# OSS_REGION is endpoint-form incl. the oss- prefix (e.g. oss-cn-shanghai).
OSS_REGION=""
OSS_BUCKET=""
OSS_ACCESS_KEY_ID=""
OSS_ACCESS_KEY_SECRET=""
# Optional custom-domain display base, e.g. https://img.shintongtech.com.
# When set, stored avatar/background URLs use it instead of the default OSS
# endpoint — bypasses Aliyun's 内地-bucket default-domain force-download (which
# breaks browser inline <img>). Empty → fallback to the aliyuncs endpoint.
# Requires the domain be ICP-备案'd + bound to the bucket; until then leave empty.
# See docs/private/plans/2026-06/06-01-oss-custom-domain-binding-runbook.md.
OSS_PUBLIC_BASE_URL=""

# --- Email (Resend HTTP API; per ADR-0026 § A-Tight v2) ---
# 发信子域 mail.shintongtech.com 已在 Resend 验证 (SPF/DKIM);发件人走该子域。
# mono 当前未实装邮件 use case —— 三个键**全仓零消费者**(2026-08-02 实测),故一律
# 注释掉:活的键会被 Check A 强制要求每个人的 .env 也带一份,等于让所有人扛三个死键。
# 接 EmailModule 时取消注释即可(下面就是当时该填的形状,子域验证结论也留在此)。
# RESEND_API_KEY=""
# RESEND_BASE_URL="https://api.resend.com"
# MAIL_FROM="noreply@mail.shintongtech.com"

# --- Marketdata vendor (per apps/server/src/config/marketdata.config.ts; 015/016) ---
# 'mock' (default; dev/test → deterministic fixtures) | 'live' (real Lixinger vendor).
# ⚠️ prod MUST be 'live' — 'mock' lets the nightly @Cron write fake data into the DB.
# 🚨 本地想改成 'live' 看真行情前先读这条：live 还**强制要求** FUTU_SHIM_URL / FUTU_SHIM_TOKEN
# (marketdata.config.ts 蓄意不给这两个键 .default())，只改本行会让**所有 boot 真 server 的
# 路径**死在 futuShimUrl 的 ZodError，且 export-openapi 那条会表现为「命令挂住 + openapi.json
# 变成 0 字节」、没有任何一行写着 boot 失败。2026-08-02 本机 .env 曾漂移成 live 且缺这两个键,
# 由此误推出过两条错误的「必备 env 前缀」规则并写进了 hook。改回来的话两个键要一起填。
# Optional vendor base URLs + sync tuning (MARKETDATA_SYNC_*, MARKETDATA_TICK_ENABLED)
# all have schema defaults in marketdata.config.ts — set via env only to override.
MARKETDATA_PROVIDER="mock"
# Required only when MARKETDATA_PROVIDER=live (Zod fail-fast at boot otherwise).
LIXINGER_TOKEN=""

# --- Push (JPush 极光推送; per apps/server/src/config/jpush.config.ts; 022) ---
# 'mock' (default; dev/test) | 'jpush' (real). When 'jpush', both creds below are
# required and validated at boot (discriminated union). Leave blank for mock.
JPUSH_GATEWAY="mock"
JPUSH_APP_KEY=""
JPUSH_MASTER_SECRET=""

# --- Chat LLM providers (per apps/server/src/config/{deepseek,minimax}.config.ts; 027/029) ---
# Both API keys are parsed at boot (Zod .min(1)) — missing/empty → boot crash,
# EVEN in mock/fake mode (config loads unconditionally). The placeholders below let
# a fresh `cp .env.example .env` boot; set CHAT_FAKE_LLM=1 to bind a deterministic
# FakeLlmProvider (no real outbound calls). Replace with real sk-... for real chat.
# Optional DEEPSEEK_BASE_URL / DEEPSEEK_MODEL / MINIMAX_BASE_URL have schema defaults
# (override via env only). International MiniMax accounts also set
# MINIMAX_BASE_URL=https://api.minimax.io/v1.
DEEPSEEK_API_KEY="dev-placeholder-deepseek-key"
MINIMAX_API_KEY="dev-placeholder-minimax-key"

# === IQS web search (per apps/server/src/config/iqs.config.ts; 030) ===
# 'mock' (default; dev/test) | 'aliyun' (prod). Unlike the LLM keys above, IQS uses a
# discriminated union — mock mode needs NO key, so a fresh boot works with no IQS_* set.
# Set IQS_PROVIDER=aliyun + IQS_API_KEY for real 阿里云 IQS GenericSearch; or set
# CHAT_FAKE_SEARCH=1 to bind a deterministic FakeSearchProvider (no real outbound calls).
# Optional IQS_BASE_URL has a schema default (override via env only).
IQS_PROVIDER="mock"
# Required only when IQS_PROVIDER=aliyun (Zod throws at boot otherwise). Blank for mock.
IQS_API_KEY=""

# === code-index grounding client (per apps/server/src/config/codeindex.config.ts; 034) ===
# 'fake' (default; dev/test → deterministic hits, NO url/token needed) | 'http' (prod;打
# services/code-index 真检索). Like IQS this is a discriminated union — fake mode needs no
# cred, so a fresh boot works with no CODE_INDEX_* set. ideation grounding (034) 经 fake
# provider 完成 IT/契约冒烟，不依赖真隧道；真接线 (WireGuard 62↔77 + 真 url/token) 部署 PR 补。
CODE_INDEX_PROVIDER="fake"
# Required only when CODE_INDEX_PROVIDER=http (Zod throws at boot otherwise). Blank for fake.
# token 仅 server env，经 Authorization: Bearer 注入，永不下发客户端 / 永不入日志。
# Local grounding 联调: URL=http://localhost:7700, first open an SSH tunnel
#   ssh -N -L 7700:localhost:7700 mbw-indexer   (prod 走 WireGuard 62↔77; 见 ops/runbook/local-dev.md)
CODE_INDEX_URL=""
CODE_INDEX_SERVICE_TOKEN=""

# === ASR 语音转写 (per apps/server/src/config/asr.config.ts; 035) ===
# 'fake' (default; dev/test/e2e → deterministic partial/final, NO key needed) | 'dashscope'
# (prod; DashScope realtime WS qwen3-asr 北京区). Like IQS/code-index this is a discriminated
# union — fake mode needs no key, so a fresh boot works with no ASR/DASHSCOPE_* set. ideation
# 语音输入 (035) 经 fake-asr 完成 IT/e2e/契约冒烟，不依赖真 key。dev/test 默认 fake；
# prod 已于 2026-06-28 翻 dashscope (真接线，账号 A DASHSCOPE_API_KEY ∈ secrets.enc.env，
# 见 .env.production)。
ASR_PROVIDER="fake"
# Required only when ASR_PROVIDER=dashscope (Zod throws at boot otherwise). Blank for fake.
# key 仅 server env，经 Authorization: Bearer 注入，永不下发客户端 (FR-014) / 永不入日志。
DASHSCOPE_API_KEY=""

# === agent-bridge 通道层 worker token (per apps/server/src/config/agent-bridge.config.ts; 子plan1 P1.2) ===
# 远程常驻 agent (OpenClaw worker) 出站轮询碰 agent-queue 端点的长期凭证 (≥256-bit, 可轮换)。
# **可选**: 未配 → null, app 正常 boot (dev/test 不轮询队列), WorkerAuthGuard fail-closed 拒一切
# (同 codeindex fake 默认)。已配但 <32 字符 → boot 时 Zod 报错。token 仅 server env，永不下发客户端。
# 生成: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# secret + 非 boot-required → prod 真值经 SOPS (secrets.enc.env) + compose 映射, 子plan3 部署 PR 补。
AGENT_WORKER_TOKEN=""

# === 富途 shim (per apps/server/src/config/marketdata.config.ts; sellput-viz Phase 1) ===
# 港机 (账号 C) 上 OpenD 的 HTTP 薄壳，经 B↔C WireGuard 隧道访问 → 值是**隧道虚 IP**
# (http://10.89.0.1:8811)，不是 localhost。live 下承担 US 交易日历 L1。
# Required only when MARKETDATA_PROVIDER=live (Zod fail-fast at boot otherwise). Blank for mock.
# 两者同属一个 SOPS 单元 (照 CODE_INDEX_URL 先例，隧道端点与其 token 一并加密) → prod 真值
# 在 secrets.enc.env；token 仅 server env，经 Authorization: Bearer 注入，永不下发客户端。
FUTU_SHIM_URL=""
FUTU_SHIM_TOKEN=""

# === 研报归档 OSS (per apps/server/src/config/research-oss.config.ts; 057) ===
# 账号 C 的**私有**桶，与上面账号 B 的 public-read 图片桶是两套凭证 / 两种 ACL / 两种用途，
# 刻意不复用同一组 OSS_* (那把 AK 的 RAM 作用域是 avatar/ + background/，权限交集为空)。
# RESEARCH_OSS_REGION 是 endpoint 形式，含 oss- 前缀 (如 oss-cn-shanghai)。
# All-or-nothing: 四个全空 → unconfigured (dev/test boot 绿；投递端点回「该能力未启用」而
# 非服务故障)；任一非空 → 四个全必填，boot 时 Zod 报错。
# AK/SK 是 SECRET → prod 真值在 secrets.enc.env，此处仅空占位。该 AK 只具 research/ 前缀的
# oss:PutObject，无读 / 列举 / 删除 (FR-018)。
RESEARCH_OSS_REGION=""
RESEARCH_OSS_BUCKET=""
RESEARCH_OSS_ACCESS_KEY_ID=""
RESEARCH_OSS_ACCESS_KEY_SECRET=""

# === guest 投递通道 token (per apps/server/src/config/guest-upload.config.ts; 057) ===
# guest-proxy (隧道内 nginx) 转发研报投递请求时无条件覆写进 Authorization: Bearer 的常量
# token —— 「通道层」凭证，证明请求确实经那条代理而来；投递方本人从不持有也无从获知
# (FR-015)，他的身份走同样被 nginx 覆写的 X-Guest 头 (可信作归属，绝不可作授权)。
# **可选**: 未配 → null，app 正常 boot，GuestUploadAuthGuard fail-closed 拒一切请求
# (未配不等于放行)。已配但 <32 字符 → boot 时 Zod 报错。
# 🚨 prod 值必须与 guest 机 render-env.sh 渲染进 nginx 的值逐字节一致；不一致的表现是恒 401，
# 而 401 按设计不泄露原因，排障只能靠对账。
# 生成: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
GUEST_UPLOAD_TOKEN=""

# === 锚模型导入 token (per apps/server/src/config/guest-upload.config.ts; 059) ===
# 第二把通道 token, 只给**直写锚**的导入口 (POST /v1/optionsdesk/anchors/model-import)。
# 🚨 MUST 与 GUEST_UPLOAD_TOKEN 取不同值: 取同值等于回到「一把 token 走天下」, 而看上去
# 是两把 —— 服务端那层就再也分不出「直写锚」与「往待审箱里放」, 整条授权闸的唯一支点
# 退回 nginx 配置一处 (059 plan §2)。
# **可选**: 未配 → null, app 正常 boot, 导入端点 fail-closed 拒一切请求。
# 生成: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ANCHOR_IMPORT_TOKEN=""
