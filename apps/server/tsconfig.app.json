{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    // 本文件现在只服务 `build`(@nx/js:swc) —— 类型检查已于 2026-08-09 迁到独立的
    // tsconfig.typecheck.json（`noEmit`，什么都不产出）。`tsconfig.spec.json` 对本文件的
    // project reference 保留，因为 eslint 的 type-aware lint 走 solution `tsconfig.json`
    // （见 eslint.config.mjs 的 `project: './tsconfig.json'`），删了会让 spec/test 丢类型信息。
    //
    // 🚨 **别把 outDir / tsBuildInfoFile 挪出 `dist`** —— 2026-08-09 实测：SWC 的 `.d.ts` 是按
    // 它自己的 `outputPath` 发的，而本文件声明的 tsBuildInfoFile 会被 SWC 内部那次 tsc 写成
    // 「已是最新」。两者一旦不同目录，任何 `tsc --build` 都会据此跳过发射 → **500+ 个 TS6305**。
    "outDir": "dist",
    "types": ["node"],
    "rootDir": "src",
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "es2021",
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "eslint.config.js",
    "eslint.config.cjs",
    "eslint.config.mjs",
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ]
}
