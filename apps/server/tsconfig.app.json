{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    // 🚨 **别把 outDir / tsBuildInfoFile 挪出 `dist` 想「解耦 build 与 typecheck」** ——
    // 2026-08-09 实测过，会更坏：`build`(@nx/js:swc, skipTypeCheck:false) 内部那次 tsc 会写
    // 本文件声明的 tsBuildInfoFile，但 `.d.ts` 是 SWC 按自己的 `outputPath` 发的。两者一旦
    // 不同目录，tsc --build 读到那份「已是最新」的 tsbuildinfo 就跳过发射 → tsconfig.spec.json
    // 经 project reference 找不到 .d.ts → **500+ 个 TS6305**。
    // 根因是**两个生产者共享同一份 tsbuildinfo**，不是「两个目录撞在一起」；解法在定序
    // （见 project.json 的 typecheck / runtime-smoke 两段注释），不在挪路径。
    "outDir": "dist",
    "types": ["node"],
    "rootDir": "src",
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "es2021",
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "eslint.config.js",
    "eslint.config.cjs",
    "eslint.config.mjs",
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ]
}
