{
  "name": "holdings-sync",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "同花顺持仓导出 → 服务端导入 本地化同步工具（自包含，可拷到任意 Mac 跑；不入 mono workspace）",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "fetch": "tsx fetch-tzzb.ts",
