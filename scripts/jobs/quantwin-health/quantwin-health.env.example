# quantwin-health 任务专属配置 —— 公开契约（只有变量名与语义，永无真值）
#
# 真值落 `~/.nvy/quantwin-health.env`（仓外，600），由 setup.sh 首次运行时从本模板生成。
# 判据：docs/conventions/information-boundary.md
#   实例 ID 走 `~/.nvy/fleet.env` 的 NVY_QUANT_WIN_ECS_ID，不在本文件重复。
#
# ⚠️ 进程名之所以不写死在仓内：它们直接暴露「这台机跑的是哪家券商的哪个实盘终端」，
#    属业务侧可识别信息；且换终端 = 改一行 env，仓内零改动（同 fleet.env 的理由）。

# ── 必填 ────────────────────────────────────────────────────────────────────
# 要监控存活的进程名，逗号分隔，**不含 .exe**。任一缺失即判 CRIT。
# 例：NVY_QUANTWIN_PROCS=foo-serv,bar-proxy,bazapp
NVY_QUANTWIN_PROCS=

# ── 可选（留空走默认）───────────────────────────────────────────────────────
# 告警里显示的主机标签。**只用代号**，永不填真实主机名。
NVY_QUANTWIN_LABEL=quant-win

# aliyun CLI profile / 地域
NVY_QUANTWIN_ALIYUN_PROFILE=mbw-server
NVY_QUANTWIN_REGION=cn-shanghai

# 磁盘阈值（MB）。默认 WARN 4096 / CRIT 2048。
# 定标依据：该机日志约 80 MB/天 ⇒ 4 GB 余量约等于 50 天预警窗，够一次从容处置。
NVY_QUANTWIN_DISK_WARN_MB=4096
NVY_QUANTWIN_DISK_CRIT_MB=2048

# 持续异常时的复推间隔（秒），默认 21600（6h）——防止每轮都推同一条。
NVY_QUANTWIN_REALERT_SEC=21600

# 每日正向摘要的最早小时（0-23），默认 9。健康时每天推一条，确认探针自身活着。
NVY_QUANTWIN_SUMMARY_HOUR=9

# 云助手结果轮询次数（每次间隔 5s），默认 12 ⇒ 最长等 60s。
NVY_QUANTWIN_POLL_MAX=12
